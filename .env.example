# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=business_os
POSTGRES_PASSWORD=business_os_dev
POSTGRES_DB=business_os

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=business-os
MINIO_SECURE=false

# Storage: local | minio
STORAGE_BACKEND=minio
LOCAL_STORAGE_PATH=./.data/storage

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Web (browser-facing URLs)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth (local HMAC tokens)
AUTH_REQUIRED=false
AUTH_SECRET=business-os-dev-secret
AUTH_TOKEN_TTL_SECONDS=43200
WORKER_SECRET=business-os-worker-secret
BOOTSTRAP_ADMIN_PASSWORD=demo-admin
BOOTSTRAP_ENABLED=true

# Pilot hardening
# Comma-separated browser origins (no *)
CORS_ORIGINS=http://localhost:3010,http://localhost:3000
DOCS_ENABLED=true
# 0 = off (tests/local). Shared pilot: 20–60
RATE_LIMIT_PER_MINUTE=0
# true = refuse startup if AUTH_REQUIRED with default secrets
PILOT_MODE=false

# Docker Compose ports (host)
WEB_PORT=3000
API_PORT_HOST=8000
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
MINIO_API_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
