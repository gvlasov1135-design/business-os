FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.32.0" \
    "pydantic-settings>=2.6.0" \
    "asyncpg>=0.30.0" \
    "redis>=5.2.0" \
    "boto3>=1.35.0" \
    "python-json-logger>=2.0.7" \
    "pytest>=8.3.0" \
    "pytest-asyncio>=0.24.0" \
    "httpx>=0.28.0"

COPY src ./src
COPY tests ./tests

ENV PYTHONPATH=/app/src

CMD ["python", "-m", "pytest", "tests/", "-v"]
